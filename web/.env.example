# Supabase — copy this file to .env.local and fill in your cloud project creds.
# Public (exposed to the browser):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never exposed to the browser):
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# AI features (/api/ai/*) — server-only. Without a key the AI buttons return
# a friendly "not configured" error; everything else works.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-4-8):
# ANTHROPIC_MODEL=

# Agent playground (/api/workflows/agents/run) — server-only OpenRouter access.
OPENROUTER_API_KEY=
# Optional model override (default: openrouter/auto):
# OPENROUTER_MODEL=

# --- Deployment mode -------------------------------------------------------
# Set to "true" ONLY on the hosted Cloud product to turn on paid plans + free-
# tier limits (also flip DB: `update platform_config set cloud_mode = true;`).
# Self-hosted installs leave this unset/false → fully unlimited, no billing UI.
NEXT_PUBLIC_CUBES_CLOUD=false
# Public base URL, used to build payment return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Dodo Payments (server-only; test mode until keys are issued) -----------
DODO_PAYMENTS_API_KEY=
# "test_mode" or "live_mode"
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_WEBHOOK_SECRET=
# Product IDs created in the Dodo dashboard:
DODO_CLOUD_PRODUCT_ID=        # recurring subscription — Cloud plan
DODO_DEVICE_PRODUCT_ID=       # one-time $100 — AT-Cubes v0.1 device


# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave blank to disable analytics.
NEXT_PUBLIC_GA_ID=


# --- Google Sheets sync, for Content Studio (server-only unless marked public)
# Google Cloud project: enable the Sheets, Drive and Picker APIs, then create a
# Web application OAuth client under "Google Auth Platform > Clients".
#
# Scopes are deliberately: openid, userinfo.email, and drive.file — NOT
# auth/spreadsheets. drive.file is non-sensitive and grants access only to files
# the user hands over through the Google Picker, which keeps the app out of
# Google's sensitive-scope security assessment.
#
# PUBLISH the consent screen ("In production"). While it sits in Testing, Google
# expires refresh tokens after 7 days and background sync dies a week later.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match an Authorized redirect URI on the client EXACTLY — scheme, host,
# port, path, no trailing slash. Set it explicitly rather than deriving it from
# request headers; Vercel preview URLs differ per deploy.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Not from Google — generate with `openssl rand -hex 32`.
# HMAC key for the signed OAuth `state` parameter (CSRF + replay protection).
GOOGLE_OAUTH_STATE_SECRET=
# Not from Google — generate with `openssl rand -hex 32`. Shared secret for the
# pg_cron -> pg_net -> sync route hop; mirror it into sheet_sync_config
# out-of-band so it is never committed (the BILLING_SYNC_SECRET pattern).
SHEET_SYNC_SECRET=
# Public: Google Picker developer key — this one reaches the browser, so restrict
# it. API restrictions: BOTH "Google Picker API" and "Google Drive API".
# Website restrictions must include https://docs.google.com/* alongside your own
# origins: the Picker renders inside an iframe hosted on docs.google.com, so that
# is the referrer Google checks. Leaving it out fails with "API developer key is
# invalid" even though the key is fine.
NEXT_PUBLIC_GOOGLE_API_KEY=
# Public: the Cloud project NUMBER (not the project id). The Picker needs it to
# attach the per-file grant to the right app. Shortcut: it is the numeric prefix
# of GOOGLE_OAUTH_CLIENT_ID — "1234567890-abc....apps.googleusercontent.com"
# means the project number is 1234567890. No need to go looking for it.
NEXT_PUBLIC_GOOGLE_APP_ID=
