{
  "name": "cubes.im-monorepo",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "build:web": "npm run build --workspace web",
    "start:web": "npm run start --workspace web",
    "lint:web": "npm run lint --workspace web",
    "typecheck:web": "npm run typecheck --workspace web",
    "db:push:web": "npm run db:push --workspace web",
    "db:types:web": "npm run db:types --workspace web",
    "app:run": "flutter run --project-dir app"
  }
}
